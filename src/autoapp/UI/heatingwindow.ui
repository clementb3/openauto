          <horstretch>0</horstretch>
          <verstretch>50</verstretch>
         </sizepolicy>
        </property>
        <property name="minimumSize">
         <size>
          <width>0</width>
          <height>50</height>
         </size>
        </property>
        <property name="styleSheet">
         <string notr="true">
										/* La glissière (le rail) */
										QSlider::groove:horizontal {
										border: 1px solid #ffffff;
										height: 1px;
										background: #444444; /* Gris foncé pour le rail */
										margin: 2px 0;
										border-radius: 3px;
										}

										/* Le curseur (le bouton mobile) */
										QSlider::handle:horizontal {
										background: #ffffff;      /* Blanc pur */
										border: 1px solid #ffffff;
										width: 18px;
										height: 18px;
										margin: -7px 0;           /* Centre le curseur sur le rail */
										border-radius: 9px;       /* Forme circulaire */
										}

										/* Partie à gauche du curseur (la zone &quot;active&quot;) */
										QSlider::sub-page:horizontal {
										background: #ffffff;      /* Blanc pour montrer la progression */
										border-radius: 3px;
										}

										/* Partie à droite du curseur */
										QSlider::add-page:horizontal {
										background: #222222;      /* Noir ou gris très foncé */
										border-radius: 3px;
										}

										/* État au survol pour plus d'interactivité */
										QSlider::handle:horizontal:hover {
										background: #f0f0f0;
										border-color: #f0f0f0;
										}
									</string>
        </property>
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <layoutdefault spacing="6" margin="11"/>
 <resources>
  <include location="../../../assets/resources.qrc"/>
 </resources>
 <connections/>
</ui>
