              </size>
             </property>
             <property name="styleSheet">
              <string notr="true">QSlider::groove:vertical {
    border-radius: 5px;                /* Bords arrondis */
    margin: 0px 5px;
}

/* La partie déjà &quot;remplie&quot; (Bleu) */
QSlider::sub-page:vertical {
background: rgba(200, 200, 200, 50);
    border-radius: 5px;
}

/* La partie vide (Gris transparent) */
QSlider::add-page:vertical {
    background: #619bd4; 

    border-radius: 5px;
}

/* Le curseur (Handle) */
QSlider::handle:vertical {
    background: #619bd4; 
    border: 1px solid #619bd4;
    height: 50px;
    margin: 0 -5px;                    /* Pour qu'il dépasse un peu du rail */
    border-radius: 7px;                /* Arrondi */
}</string>
             </property>
             <property name="maximum">
              <number>3</number>
             </property>
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
             <property name="invertedControls">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </item>
